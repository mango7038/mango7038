<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="12dp" android:paddingRight="12dp"
    android:paddingTop="12dp" android:paddingBottom="10dp"
    android:background="@drawable/widget_background">

    <!-- Match the reference: small single-row month header with Today pill. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="34dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widgetTitle"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="OCT 2026" android:textColor="#FBF9FF"
            android:textSize="18sp" android:textStyle="bold"
            android:maxLines="1"/>
        <TextView android:id="@+id/widgetToday"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingHorizontal="11dp" android:paddingVertical="6dp"
            android:text="Today" android:textColor="#ECE7FA"
            android:textSize="12sp" android:background="@drawable/widget_today_bg"/>
    </LinearLayout>

    <!-- 7 short rounded day cards. Calendar dots are BELOW the cards. -->
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="64dp" android:layout_marginTop="4dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widgetPrevWeek"
            android:layout_width="12dp" android:layout_height="match_parent"
            android:gravity="center" android:text="‹" android:textSize="15sp"
            android:textColor="#A99DC9" />
        <FrameLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="62dp">
            <ImageView android:id="@+id/widgetCalendar"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="Seven day calendar; green Story, blue Feed, red Festival dots"/>
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="match_parent" android:orientation="horizontal">
                <TextView android:id="@+id/widgetDate0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:contentDescription="Select day"/>
                <TextView android:id="@+id/widgetDate1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:contentDescription="Select day"/>
                <TextView android:id="@+id/widgetDate2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:contentDescription="Select day"/>
                <TextView android:id="@+id/widgetDate3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:contentDescription="Select day"/>
                <TextView android:id="@+id/widgetDate4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:contentDescription="Select day"/>
                <TextView android:id="@+id/widgetDate5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:contentDescription="Select day"/>
                <TextView android:id="@+id/widgetDate6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:contentDescription="Select day"/>
            </LinearLayout>
        </FrameLayout>
        <TextView android:id="@+id/widgetNextWeek"
            android:layout_width="12dp" android:layout_height="match_parent"
            android:gravity="center" android:text="›" android:textSize="15sp"
            android:textColor="#A99DC9"/>
    </LinearLayout>

    <!-- Bottom panel remains within the widget's height, even at default launcher sizing. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="7dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widgetSecond"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="CALENDAR" android:textColor="#D7CFF5"
                android:textStyle="bold" android:textSize="10sp"
                android:maxLines="1"/>
            <TextView android:id="@+id/widgetNext"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="No scheduled posts"
                android:textColor="#FFFFFF" android:textStyle="bold"
                android:textSize="16sp" android:maxLines="2"
                android:ellipsize="end"/>
            <TextView android:id="@+id/widgetThird"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:text="Create or upload a poster for this date"
                android:textColor="#BEB8D4" android:textSize="10sp"
                android:maxLines="2" android:ellipsize="end"/>
            <TextView android:id="@+id/widgetSelectedDay"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:visibility="gone" android:text="Today"/>
        </LinearLayout>

        <!-- Central poster thumbnail + a compact post counter and navigation arrows. -->
        <FrameLayout android:layout_width="88dp" android:layout_height="84dp"
            android:layout_marginHorizontal="4dp">
            <ImageView android:id="@+id/widgetBrandMark"
                android:layout_width="72dp" android:layout_height="72dp"
                android:layout_gravity="center" android:alpha="0.14"
                android:src="@mipmap/ic_launcher" android:scaleType="fitCenter"
                android:contentDescription="PostFlow background watermark"/>
            <ImageView android:id="@+id/widgetPoster"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:layout_marginTop="15dp" android:layout_marginBottom="16dp"
                android:scaleType="fitCenter"
                android:contentDescription="Selected poster preview"/>
            <TextView android:id="@+id/widgetOpen"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:text="" android:contentDescription="Open full poster"/>
            <TextView android:id="@+id/widgetPostPosition"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:text="0/0" android:textSize="9sp"
                android:paddingHorizontal="5dp" android:paddingVertical="2dp"
                android:textColor="#ECE6FF"
                android:background="@drawable/widget_counter_bg"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="26dp"
                android:layout_gravity="bottom" android:orientation="horizontal">
                <TextView android:id="@+id/widgetPrevPost"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="match_parent" android:gravity="center"
                    android:text="‹" android:textSize="23sp" android:textColor="#FFFFFF"/>
                <TextView android:id="@+id/widgetNextPost"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="match_parent" android:gravity="center"
                    android:text="›" android:textSize="23sp" android:textColor="#FFFFFF"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Equal-sized controls, as in GraphicaNest reference. -->
        <LinearLayout android:layout_width="58dp" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/widgetCreate"
                android:layout_width="match_parent" android:layout_height="39dp"
                android:gravity="center" android:text="Create"
                android:textColor="#FFFFFF" android:textSize="11sp"
                android:textStyle="bold" android:background="@drawable/widget_view_bg"/>
            <TextView android:id="@+id/widgetUpload"
                android:layout_width="match_parent" android:layout_height="43dp"
                android:layout_marginTop="6dp"
                android:gravity="center" android:text="Upload"
                android:textColor="#FFFFFF" android:textSize="11sp"
                android:background="@drawable/widget_share_bg"/>
            <TextView android:id="@+id/widgetShare"
                android:layout_width="1dp" android:layout_height="1dp"
                android:visibility="gone" android:text="Share"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>